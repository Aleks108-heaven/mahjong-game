<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <!-- Exact versions plus a lock file: a restore can't silently pick up a different package. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TestMahjongGame.csproj" />
  </ItemGroup>

  <!-- App code that has no window in it, compiled here so settings and translations are tested on every platform. -->
  <ItemGroup>
    <Compile Include="..\Wpf\UserSettings.cs" Link="App\UserSettings.cs" />
    <Compile Include="..\Wpf\Loc.cs" Link="App\Loc.cs" />
  </ItemGroup>

</Project>
