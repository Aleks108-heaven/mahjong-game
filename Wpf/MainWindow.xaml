<Window x:Class="MahjongTable.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mahjong Table" Icon="app.ico" Width="1400" Height="820" MinWidth="640" MinHeight="400"
        WindowStartupLocation="CenterScreen" Background="#12372B"
        FontFamily="Segoe UI" PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <SolidColorBrush x:Key="FeltBrush" Color="#12372B"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#1B4D3C"/>
        <SolidColorBrush x:Key="PanelEdgeBrush" Color="#2F7059"/>
        <SolidColorBrush x:Key="TextBrush" Color="#F2EFE6"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#B9CFC4"/>
        <SolidColorBrush x:Key="GoldBrush" Color="#E8B84A"/>
        <SolidColorBrush x:Key="InkBrush" Color="#16201B"/>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="#2A6650"/>
            <Setter Property="BorderBrush" Value="#4C8F76"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1.5" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="White"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="3"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="{StaticResource GoldBrush}"/>
            <Setter Property="BorderBrush" Value="#F5D58A"/>
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
        </Style>

        <Style x:Key="ToggleAction" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="#2A6650"/>
            <Setter Property="BorderBrush" Value="#4C8F76"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1.5" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F2EFE6"/>
                                <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="White"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="3"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Chrome-less button wrapping a tile: lifts on hover, white ring on keyboard focus. -->
        <Style x:Key="TileButton" TargetType="Button">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Ring" BorderThickness="2" BorderBrush="Transparent" CornerRadius="7" Margin="-2">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform Y="-8"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Ring" Property="BorderBrush" Value="White"/>
                                <Setter TargetName="Ring" Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform Y="-8"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Chip" TargetType="Border">
            <Setter Property="Background" Value="#0F2F24"/>
            <Setter Property="BorderBrush" Value="{StaticResource PanelEdgeBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
        </Style>

        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,18,0,6"/>
        </Style>
    </Window.Resources>

    <!-- The whole table is laid out at a fixed design size and scaled to fit the window. -->
    <Viewbox Stretch="Uniform">
    <Grid Width="1520" Height="860" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock x:Name="TitleText" Text="Mahjong Table" FontSize="30" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                <TextBlock x:Name="SubtitleText" Text="Riichi engine · four bots play one round" FontSize="14" Foreground="{StaticResource MutedBrush}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Style="{StaticResource Chip}" AutomationProperties.Name="Dora indicators">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="DoraLabel" Text="Dora" Foreground="{StaticResource TextBrush}" FontSize="14" FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                        <StackPanel x:Name="DoraTiles" Orientation="Horizontal" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Chip}">
                    <TextBlock x:Name="TurnText" Text="Turn 0" Foreground="{StaticResource TextBrush}" FontSize="14" FontWeight="SemiBold"/>
                </Border>
                <Border Style="{StaticResource Chip}">
                    <TextBlock x:Name="WallText" Text="Wall 70 left" Foreground="{StaticResource TextBrush}" FontSize="14" FontWeight="SemiBold"/>
                </Border>
                <Border Style="{StaticResource Chip}">
                    <TextBlock x:Name="SeedText" Text="Seed -" Foreground="{StaticResource TextBrush}" FontSize="14" FontWeight="SemiBold"/>
                </Border>
            </StackPanel>
        </Grid>

        <!-- Banners: "your move" while playing, result when the round ends -->
        <StackPanel Grid.Row="1">
            <Border x:Name="TurnBanner" Visibility="Collapsed" Background="#F2EFE6" CornerRadius="10"
                    Padding="18,10" Margin="0,0,0,14">
                <DockPanel>
                    <Button x:Name="HintButton" DockPanel.Dock="Right" Content="Hint (H)" Style="{StaticResource ActionButton}"
                            Padding="16,8" Click="HintButton_Click" VerticalAlignment="Center"
                            ToolTip="Show the discard that keeps you closest to winning"/>
                    <StackPanel x:Name="KanButtons" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="YourMoveText" Text="Your move: click a tile to discard it."
                                   FontSize="20" FontWeight="Bold" Foreground="{StaticResource InkBrush}"
                                   AutomationProperties.LiveSetting="Polite"/>
                        <TextBlock x:Name="HintMessage" FontSize="13" Foreground="#2C4A3D" Margin="0,2,0,0"
                                   Text="Blue outline = the tile you just drew. Tab and Enter also work."/>
                    </StackPanel>
                </DockPanel>
            </Border>
            <Border x:Name="CallBanner" Visibility="Collapsed" Background="#F2EFE6" CornerRadius="10"
                    Padding="18,10" Margin="0,0,0,14">
                <DockPanel>
                    <StackPanel x:Name="CallButtons" DockPanel.Dock="Right" Orientation="Horizontal"
                                VerticalAlignment="Center"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="CallTitle" FontSize="20" FontWeight="Bold" Foreground="{StaticResource InkBrush}"
                                   TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive"/>
                        <TextBlock x:Name="CallHint" FontSize="13" Foreground="#2C4A3D" Margin="0,2,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </DockPanel>
            </Border>
            <Border x:Name="ResultBanner" Visibility="Collapsed" Background="{StaticResource GoldBrush}"
                    CornerRadius="10" Padding="18,12" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock x:Name="ResultText" FontSize="20" FontWeight="Bold" Foreground="{StaticResource InkBrush}"
                               TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                    <TextBlock x:Name="ResultYaku" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}"
                               TextWrapping="Wrap" Margin="0,4,0,0"/>
                    <TextBlock x:Name="ResultFooter" Text="Press New round (N) to deal again, or enter a seed to replay a round."
                               FontSize="13" Foreground="#3B2F0E" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Table + sidebar -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <UniformGrid x:Name="PlayerGrid" Grid.Column="0" Rows="2" Columns="2"/>

            <Border Grid.Column="1" Margin="14,0,0,0" Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource PanelEdgeBrush}" BorderThickness="1" CornerRadius="12" Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock x:Name="ControlsLabel" Text="CONTROLS" Style="{StaticResource SectionLabel}" Margin="0,0,0,8"/>
                        <Button x:Name="NextButton" Content="Next turn  ▶" Style="{StaticResource PrimaryButton}"
                                Click="NextButton_Click" ToolTip="Play one full turn (Right arrow)"/>
                        <ToggleButton x:Name="AutoButton" Content="Auto-play" Style="{StaticResource ToggleAction}" Margin="0,8,0,0"
                                      Checked="AutoButton_Changed" Unchecked="AutoButton_Changed" ToolTip="Play turns automatically (A)"/>
                        <TextBlock x:Name="SpeedLabel" Text="Speed: 600 ms per turn" Style="{StaticResource SectionLabel}" Margin="0,12,0,2"/>
                        <Slider x:Name="SpeedSlider" Minimum="100" Maximum="1500" Value="600" IsDirectionReversed="True"
                                ValueChanged="SpeedSlider_ValueChanged" AutomationProperties.Name="Auto-play speed"/>
                        <Button x:Name="NewButton" Content="New round" Style="{StaticResource ActionButton}" Margin="0,14,0,0"
                                Click="NewButton_Click" ToolTip="Deal a new round (N)"/>
                        <TextBlock x:Name="YourSeatLabel" Text="YOUR SEAT" Style="{StaticResource SectionLabel}" Margin="0,16,0,6"/>
                        <UniformGrid x:Name="SeatPicker" Columns="5">
                            <RadioButton x:Name="SeatWatch" Content="Watch" Tag="-1" GroupName="Seat" Style="{StaticResource ToggleAction}"
                                         Padding="2,7" FontSize="12" Margin="0,0,3,0" Checked="Seat_Checked"
                                         ToolTip="Spectate: four bots play"/>
                            <RadioButton Content="East" Tag="0" GroupName="Seat" Style="{StaticResource ToggleAction}"
                                         Padding="2,7" FontSize="12" Margin="0,0,3,0" Checked="Seat_Checked" IsChecked="True"/>
                            <RadioButton Content="South" Tag="1" GroupName="Seat" Style="{StaticResource ToggleAction}"
                                         Padding="2,7" FontSize="12" Margin="0,0,3,0" Checked="Seat_Checked"/>
                            <RadioButton Content="West" Tag="2" GroupName="Seat" Style="{StaticResource ToggleAction}"
                                         Padding="2,7" FontSize="12" Margin="0,0,3,0" Checked="Seat_Checked"/>
                            <RadioButton Content="North" Tag="3" GroupName="Seat" Style="{StaticResource ToggleAction}"
                                         Padding="2,7" FontSize="12" Checked="Seat_Checked"/>
                        </UniformGrid>
                        <TextBlock x:Name="SeatHint" Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap"
                                   Margin="0,4,0,0" Text="Picking a seat starts a new round. Bots' hands stay hidden."/>
                        <TextBlock x:Name="LangLabel" Text="LANGUAGE" Style="{StaticResource SectionLabel}" Margin="0,14,0,6"/>
                        <UniformGrid Columns="2">
                            <RadioButton x:Name="LangEn" Content="English" Tag="en" GroupName="Lang" Style="{StaticResource ToggleAction}"
                                         Padding="2,7" FontSize="12" Margin="0,0,3,0" Checked="Lang_Checked"/>
                            <RadioButton x:Name="LangUk" Content="Українська" Tag="uk" GroupName="Lang" Style="{StaticResource ToggleAction}"
                                         Padding="2,7" FontSize="12" IsChecked="True" Checked="Lang_Checked"/>
                        </UniformGrid>
                        <TextBlock x:Name="SeedLabel" Text="SEED (OPTIONAL)" Style="{StaticResource SectionLabel}" Margin="0,14,0,6"/>
                        <TextBox x:Name="SeedBox" Background="#0F2F24" Foreground="{StaticResource TextBrush}"
                                 CaretBrush="White" BorderBrush="#4C8F76" BorderThickness="1.5" Padding="8,7" FontSize="14"
                                 AutomationProperties.Name="Seed" ToolTip="A whole number replays the same round"/>
                        <TextBlock x:Name="SeedHint" Text="Empty = random round. A number replays the same round."
                                   Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        <CheckBox x:Name="ShowHands" Content="Show all hands" IsChecked="True" Margin="0,12,0,0"
                                  Foreground="{StaticResource TextBrush}" FontSize="14"
                                  Checked="ShowHands_Changed" Unchecked="ShowHands_Changed"/>
                        <TextBlock x:Name="LogLabel" Text="GAME LOG" Style="{StaticResource SectionLabel}"/>
                    </StackPanel>

                    <TextBox x:Name="LogBox" Grid.Row="1" IsReadOnly="True" FontFamily="Consolas" FontSize="11.5"
                             Background="#0F2F24" Foreground="{StaticResource TextBrush}" BorderBrush="#2F7059"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap"
                             AutomationProperties.Name="Game log"/>

                    <TextBlock x:Name="KeysText" Grid.Row="2" Margin="0,12,0,0" Foreground="{StaticResource MutedBrush}" FontSize="12"
                               Text="Keys: → next turn · A auto-play · N new round" TextWrapping="Wrap"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
    </Viewbox>
</Window>
